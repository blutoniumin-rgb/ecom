DATABASE_URL="file:./dev.db"
# Neon (production and npm run dev:neon). Put the real strings in .env.neon.local, not here.
# DATABASE_URL is the pooled URL. DIRECT_URL is the direct URL, used by prisma migrate deploy.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
